    "settings.reset.confirmation_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browsers, apps, rules and shortcuts will be removed. This can’t be undone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузеры, приложения, правила и сочетания клавиш будут удалены. Это действие нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Browser, Apps, Regeln und Kurzbefehle werden entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos navigateurs, apps, règles et raccourcis seront supprimés. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tus navegadores, apps, reglas y atajos. Esta acción no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus navegadores, apps, regras e atalhos serão removidos. Esta ação não pode ser desfeita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser, app, regole e scorciatoie verranno rimossi. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザ、アプリ、ルール、ショートカットが削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저, 앱, 규칙 및 단축키가 제거됩니다. 이 작업은 되돌릴 수 없습니다."
