            "state": "translated",
            "value": "The selected profile is unavailable. Enable profile access or rescan browsers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный профиль недоступен. Разрешите доступ к профилям или повторите поиск браузеров."
          }
        },
        "de": {
