    "rules.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open matching links automatically. For example, send https://example.com/work/* to your work browser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически открывайте подходящие ссылки. Например, отправляйте https://example.com/work/* в рабочий браузер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passende Links automatisch öffnen. Zum Beispiel https://example.com/work/* an den Arbeitsbrowser senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez automatiquement les liens correspondants. Par exemple, envoyez https://example.com/work/* vers votre navigateur professionnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre automáticamente los enlaces coincidentes. Por ejemplo, envía https://example.com/work/* a tu navegador de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra links correspondentes automaticamente. Por exemplo, envie https://example.com/work/* ao navegador de trabalho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri automaticamente i link corrispondenti. Ad esempio, invia https://example.com/work/* al browser di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するリンクを自動で開きます。例：https://example.com/work/*を仕事用ブラウザに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 링크를 자동으로 엽니다. 예를 들어 https://example.com/work/*를 업무용 브라우저로 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动打开匹配的链接。例如，将 https://example.com/work/* 发送到工作浏览器。"
          }
        }
      }
    },
