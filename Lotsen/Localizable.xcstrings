    "apps.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer an app for a website, such as Figma for figma.com. You still choose where each link opens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложите приложение для сайта, например Figma для figma.com. Вы по-прежнему выбираете, где открыть каждую ссылку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App für eine Website anbieten, etwa Figma für figma.com. Du wählst weiterhin, wo jeder Link geöffnet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposez une app pour un site, comme Figma pour figma.com. Vous choisissez toujours où ouvrir chaque lien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrece una app para un sitio, como Figma para figma.com. Tú sigues eligiendo dónde abrir cada enlace."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofereça um app para um site, como Figma para figma.com. Você continua escolhendo onde abrir cada link."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponi un’app per un sito, come Figma per figma.com. Scegli comunque dove aprire ogni link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "figma.comにFigmaなど、サイト用のアプリを候補に追加します。リンクを開く先は引き続き自分で選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "figma.com에 Figma처럼 웹사이트에 사용할 앱을 추가하세요. 각 링크를 열 위치는 계속 직접 선택합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为网站提供应用选项，例如为 figma.com 添加 Figma。您仍可选择每个链接的打开位置。"
          }
        }
      }
    },
