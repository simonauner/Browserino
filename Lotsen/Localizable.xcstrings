    "browsers.list.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Use Add shortcut to assign a key, and the eye to hide a browser from the picker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. «Назначить» задаёт клавишу, а глаз скрывает браузер в окне выбора."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umordnen ziehen. Mit „Zuweisen“ eine Taste festlegen, mit dem Auge einen Browser in der Auswahl ausblenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. « Assigner » attribue une touche, et l’œil masque un navigateur dans le sélecteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Usa Asignar para elegir una tecla y el ojo para ocultar un navegador en el selector."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Use Atribuir para escolher uma tecla e o olho para ocultar um navegador no seletor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Usa Assegna per scegliere un tasto e l’occhio per nascondere un browser nel selettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えます。「割り当て」でキーを設定し、目のアイコンで選択画面からブラウザを隠します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 바꾸세요. 지정으로 키를 설정하고, 눈 아이콘으로 선택 창에서 브라우저를 숨깁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序。使用“分配”设置按键，点按眼睛图标可在选择器中隐藏浏览器。"
          }
        }
      }
    },
