    "errors.automation_permission_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Lotsen to control the browser in System Settings → Privacy & Security → Automation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Lotsen управлять браузером: Системные настройки → Конфиденциальность и безопасность → Автоматизация."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Lotsen die Browsersteuerung unter Systemeinstellungen → Datenschutz & Sicherheit → Automation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Lotsen à contrôler le navigateur dans Réglages système → Confidentialité et sécurité → Automatisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a Lotsen controlar el navegador en Ajustes del sistema → Privacidad y seguridad → Automatización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita ao Lotsen controlar o navegador em Ajustes do sistema → Privacidade e Segurança → Automação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Lotsen di controllare il browser in Impostazioni di sistema → Privacy e sicurezza → Automazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → オートメーションでLotsenによるブラウザの制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 자동화에서 Lotsen의 브라우저 제어를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
