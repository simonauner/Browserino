    "apps.list.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links to these domains also offer the chosen app in the picker. To open links without showing the picker, add a rule under Rules. Double-click a domain to edit it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ссылок на эти домены в окне выбора также появится выбранное приложение. Чтобы открывать ссылки без окна выбора, добавьте правило в разделе «Правила». Дважды щёлкните домен, чтобы изменить его."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Links zu diesen Domains bietet die Auswahl auch die gewählte App an. Um Links ohne Auswahl zu öffnen, füge unter „Regeln“ eine Regel hinzu. Doppelklicke auf eine Domain, um sie zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les liens vers ces domaines, le sélecteur propose aussi l’app choisie. Pour ouvrir des liens sans afficher le sélecteur, ajoutez une règle dans Règles. Double-cliquez sur un domaine pour le modifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para los enlaces a estos dominios, el selector también ofrece la app elegida. Para abrir enlaces sin mostrar el selector, añade una regla en Reglas. Haz doble clic en un dominio para editarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para links destes domínios, o seletor também oferece o app escolhido. Para abrir links sem mostrar o seletor, adicione uma regra em Regras. Clique duas vezes em um domínio para editá-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i link a questi domini, il selettore propone anche l’app scelta. Per aprire i link senza mostrare il selettore, aggiungi una regola in Regole. Fai doppio clic su un dominio per modificarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのドメインへのリンクでは、選択画面に指定したアプリも表示されます。選択画面を表示せずに開くには、「ルール」でルールを追加してください。ドメインをダブルクリックすると編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 도메인의 링크를 열 때 선택 창에 지정한 앱도 표시됩니다. 선택 창 없이 링크를 열려면 규칙에서 규칙을 추가하세요. 도메인을 이중 클릭하여 편집하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开这些域名的链接时，选择器中也会显示所选应用。若要不显示选择器直接打开链接，请在“规则”中添加规则。双击域名即可编辑。"
          }
        }
      }
    },
    "rules.list.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links that match a rule open in its app without the picker. Double-click a rule to edit it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки, подходящие под правило, открываются в его приложении без окна выбора. Дважды щёлкните правило, чтобы изменить его."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, die einer Regel entsprechen, öffnen ohne Auswahl in deren App. Doppelklicke auf eine Regel, um sie zu bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens qui correspondent à une règle s’ouvrent dans son app sans sélection. Double-cliquez sur une règle pour la modifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que coinciden con una regla se abren en su app sin preguntar. Haz doble clic en una regla para editarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links que correspondem a uma regra abrem no app dela sem perguntar. Clique duas vezes em uma regra para editá-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link che corrispondono a una regola si aprono nella sua app senza chiedere. Fai doppio clic su una regola per modificarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールに一致するリンクは、選択画面なしでそのアプリで開きます。ルールをダブルクリックすると編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙과 일치하는 링크는 선택 창 없이 해당 앱에서 열립니다. 규칙을 이중 클릭하여 편집하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配规则的链接会直接在其应用中打开。双击规则即可编辑。"
          }
        }
      }
    },
    "locations.add.instructions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a new location by selecting a directory (use ⇧⌘G in the Finder to enter the path)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте папку поиска (для ввода пути в Finder нажмите ⇧⌘G)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchort hinzufügen (im Finder mit ⇧⌘G den Pfad eingeben)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier de recherche (⇧⌘G dans le Finder pour saisir le chemin)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta de búsqueda (usa ⇧⌘G en Finder para introducir la ruta)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pasta de busca (use ⇧⌘G no Finder para digitar o caminho)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una cartella di ricerca (usa ⇧⌘G nel Finder per inserire il percorso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索フォルダを追加します（Finderで⇧⌘Gを押すとパスを入力できます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 폴더를 추가하세요(Finder에서 ⇧⌘G로 경로 입력)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹以添加搜索位置（在 Finder 中按 ⇧⌘G 输入路径）。"
          }
        }
      }
    },
    "locations.list.instructions": {
      "extractionState": "manual",
      "localizations": {
