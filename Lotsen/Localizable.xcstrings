    "browsers.private_argument.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private-window arguments apply to all profiles of a browser. Defaults are provided for supported browsers. An empty argument disables private opening."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы приватного окна применяются ко всем профилям браузера. Для поддерживаемых браузеров заданы значения по умолчанию. Пустой аргумент отключает приватное открытие."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Argumente für private Fenster gelten für alle Profile eines Browsers. Unterstützte Browser haben Standardwerte. Ein leeres Argument deaktiviert privates Öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arguments de fenêtre privée s’appliquent à tous les profils d’un navigateur. Les navigateurs pris en charge ont des valeurs par défaut. Un argument vide désactive l’ouverture privée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos de ventana privada se aplican a todos los perfiles. Hay valores predeterminados para los navegadores compatibles. Un argumento vacío desactiva la apertura privada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os argumentos de janela privada se aplicam a todos os perfis. Navegadores compatíveis têm valores padrão. Um argumento vazio desativa a abertura privada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti per le finestre private si applicano a tutti i profili. I browser supportati hanno valori predefiniti. Un argomento vuoto disattiva l’apertura privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートウインドウの引数はブラウザの全プロフィールに適用されます。対応ブラウザには既定値があります。引数を空にするとプライベートで開く機能が無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 창 인수는 브라우저의 모든 프로필에 적용됩니다. 지원되는 브라우저에는 기본값이 제공됩니다. 인수를 비우면 비공개로 열기가 비활성화됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私窗口参数适用于浏览器的所有配置文件。支持的浏览器已提供默认值。留空可禁用隐私模式打开。"
          }
        }
      }
    },
