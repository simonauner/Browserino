    "rules.bypass_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Option when opening a link to show the picker once without applying rules."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте Option при открытии ссылки, чтобы один раз показать выбор без применения правил."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen eines Links die Wahltaste gedrückt halten, um einmalig die Auswahl ohne Regeln anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Option en ouvrant un lien pour afficher le sélecteur une fois sans appliquer les règles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada Opción al abrir un enlace para mostrar el selector una vez sin aplicar las reglas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure Option ao abrir um link para mostrar o seletor uma vez sem aplicar as regras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Opzione quando apri un link per mostrare il selettore una volta senza applicare le regole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを開くときにOptionキーを押し続けると、そのときだけルールを適用せずに選択画面を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 열 때 Option 키를 누르면 한 번만 규칙을 적용하지 않고 선택기를 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开链接时按住 Option 键，可仅此次跳过规则并显示选择器。"
          }
        }
      }
    },
    "tabs.transfer.profile_copy_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When opening in a profile of the same browser, the original tab stays open."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При открытии в профиле того же браузера исходная вкладка остаётся открытой."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen in einem Profil desselben Browsers bleibt der ursprüngliche Tab geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de l’ouverture dans un profil du même navigateur, l’onglet d’origine reste ouvert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir en un perfil del mismo navegador, la pestaña original permanece abierta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir em um perfil do mesmo navegador, a aba original permanece aberta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendo in un profilo dello stesso browser, la scheda originale rimane aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じブラウザのプロファイルで開く場合、元のタブは開いたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 브라우저의 프로필에서 열면 원래 탭은 열린 상태로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一浏览器的配置文件中打开时，原标签页会保持打开。"
          }
        }
      }
    }
