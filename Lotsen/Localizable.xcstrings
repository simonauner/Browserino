    "picker.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a browser in Settings, or choose another app to open your links."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите браузер в настройках или выберите другое приложение для открытия ссылок."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Browser in den Einstellungen einblenden oder eine andere App zum Öffnen der Links wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez un navigateur dans les réglages ou choisissez une autre app pour ouvrir vos liens."
