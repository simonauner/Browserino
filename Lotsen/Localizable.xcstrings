    "shortcuts.browsers.private_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a browser's key in the picker to open the link there. Hold Shift to open it in a private window."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите клавишу браузера в окне выбора, чтобы открыть в нём ссылку. Удерживайте Shift, чтобы открыть её в приватном окне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke in der Auswahl die Taste eines Browsers, um den Link dort zu öffnen. Halte die Umschalttaste gedrückt, um ihn in einem privaten Fenster zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la touche d'un navigateur dans le sélecteur pour y ouvrir le lien. Maintenez Maj pour l'ouvrir dans une fenêtre privée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa la tecla de un navegador en el selector para abrir el enlace en él. Mantén Mayús para abrirlo en una ventana privada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione a tecla de um navegador no seletor para abrir o link nele. Segure Shift para abri-lo em uma janela privada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi il tasto di un browser nel selettore per aprirvi il link. Tieni premuto Maiusc per aprirlo in una finestra privata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択画面でブラウザのキーを押すと、そのブラウザでリンクを開きます。Shiftキーを押したままにするとプライベートウインドウで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택기에서 브라우저의 키를 누르면 해당 브라우저에서 링크가 열립니다. Shift 키를 누른 채로 누르면 개인 정보 보호 창에서 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在选择器中按下浏览器对应的键即可在其中打开链接。按住 Shift 键可在隐私窗口中打开。"
          }
        }
      }
    },
