    "apps.editor.host_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subdomains match too. Leave it empty to offer the app for every link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддомены тоже подходят. Оставьте поле пустым, чтобы предлагать приложение для всех ссылок."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Subdomains passen ebenfalls. Leer lassen, um die App für alle Links anzubieten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-domaines correspondent aussi. Laissez vide pour proposer l’application pour tous les liens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subdominios también coinciden. Déjalo vacío para ofrecer la aplicación en todos los enlaces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Subdomínios também correspondem. Deixe vazio para oferecer o aplicativo em todos os links."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche i sottodomini corrispondono. Lascia vuoto per proporre l’app per tutti i link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブドメインも対象です。空欄にすると、すべてのリンクでこのアプリを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 도메인도 포함됩니다. 비워 두면 모든 링크에 이 앱을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子域名也会匹配。留空则对所有链接提供此应用。"
          }
        }
      }
    },
    "apps.editor.replace_scheme_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the link with this scheme instead of http or https, so an app such as Figma receives it directly. Leave it empty to keep the link as it is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает ссылку с этой схемой вместо http или https, чтобы приложение, например Figma, получило её напрямую. Оставьте поле пустым, чтобы не менять ссылку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Link mit diesem Schema statt http oder https, damit eine App wie Figma ihn direkt erhält. Leer lassen, um den Link unverändert zu lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le lien avec ce schéma au lieu de http ou https, pour qu’une application comme Figma le reçoive directement. Laissez vide pour garder le lien tel quel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el enlace con este esquema en lugar de http o https, para que una aplicación como Figma lo reciba directamente. Déjalo vacío para mantener el enlace tal cual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o link com este esquema em vez de http ou https, para que um aplicativo como o Figma o receba diretamente. Deixe vazio para manter o link como está."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il link con questo schema invece di http o https, così un’app come Figma lo riceve direttamente. Lascia vuoto per mantenere il link invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http や https の代わりにこのスキームでリンクを開き、Figma などのアプリが直接受け取れるようにします。空欄ならリンクはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "http 또는 https 대신 이 스킴으로 링크를 열어 Figma 같은 앱이 직접 받도록 합니다. 비워 두면 링크를 그대로 둡니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用此协议代替 http 或 https 打开链接，让 Figma 等应用直接接收。留空则保持链接不变。"
          }
        }
      }
    },
    "apps.editor.invalid_scheme": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scheme starts with a letter and contains only letters, digits, +, - and ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Схема начинается с буквы и содержит только буквы, цифры, +, - и ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
