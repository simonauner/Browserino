    "rules.list.priority": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first matching rule wins. Drag rules or use the arrow buttons to change priority."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется первое совпавшее правило. Меняйте порядок перетаскиванием или стрелками."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste passende Regel gilt. Regeln ziehen oder mit den Pfeiltasten die Priorität ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première règle correspondante est utilisée. Faites glisser les règles ou utilisez les flèches pour changer leur priorité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa la primera regla coincidente. Arrastra las reglas o usa las flechas para cambiar la prioridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira regra correspondente é usada. Arraste as regras ou use as setas para alterar a prioridade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene usata la prima regola corrispondente. Trascina le regole o usa le frecce per cambiare la priorità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に一致したルールが適用されます。ドラッグまたは矢印ボタンで優先順位を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 일치하는 규칙이 적용됩니다. 규칙을 드래그하거나 화살표 버튼으로 우선순위를 변경하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用第一条匹配的规则。拖动规则或使用箭头按钮更改优先级。"
          }
        }
      }
    },
